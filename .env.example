# SQLite for local dev; switch to Postgres via docker-compose
DATABASE_URL=sqlite:///./orders.db
# DATABASE_URL=postgresql+psycopg://orders:orders@localhost:5432/orders

# Comma-separated scopes granted to the agent
MCP_SCOPES=orders:read,inventory:read,orders:write,inventory:write

# Token a human must send to approve/reject actions (X-Admin-Token header)
ADMIN_TOKEN=change-me

# Minutes before an unapproved action expires
ACTION_TTL_MINUTES=30
